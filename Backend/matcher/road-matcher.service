# systemd unit for the road matcher. install_matcher.sh fills in @USER@ and @BACKEND@ and
# installs it as /etc/systemd/system/road-matcher.service. Don't install this file by hand.
[Unit]
Description=Road Quality Mapper road matcher (Valhalla -> Supabase)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@BACKEND@/matcher
EnvironmentFile=@BACKEND@/matcher/matcher.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=@BACKEND@/matcher/.venv/bin/python @BACKEND@/matcher/road_matcher.py
Restart=always
RestartSec=30

# Lock-down: an ordinary user with no extra rights, a read-only view of the disk, and network
# access to this machine only (Supabase on 54322, Valhalla on 8002).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=1G

[Install]
WantedBy=multi-user.target
